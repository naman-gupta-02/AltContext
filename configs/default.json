{
  "model": {
    "base_model_id": "HuggingFaceTB/SmolVLM-256M-Instruct",
    "base_model_revision": "7e3e67edbbed1bf9888184d9df282b700a323964",
    "dtype": "float32"
  },
  "processor": {
    "do_image_splitting": false,
    "longest_edge": 512,
    "note": "Concadia images are 256x256; one 512px global view = 64 image tokens. Splitting would upscale to 17 tiles (~1100 tokens) with no extra detail."
  },
  "context": {
    "max_words": 200,
    "max_chars": 1000,
    "caption_max_words": 60,
    "heading_max_words": 20,
    "title_max_words": 20,
    "field_order": ["caption", "heading", "paragraph", "page_title"]
  },
  "generation": {
    "brief": {"max_new_tokens": 60, "do_sample": false, "num_beams": 1, "repetition_penalty": 1.1},
    "detailed": {"max_new_tokens": 160, "do_sample": false, "num_beams": 1, "repetition_penalty": 1.1}
  },
  "data": {
    "seed": 13,
    "milestone_n": 100,
    "tiny_n": 20,
    "pilot_n": 300,
    "train_n": 5000,
    "val_n": 300,
    "test_n": 500
  },
  "lora": {
    "r": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules_regex": "^model\\.text_model\\.layers\\.\\d+\\.self_attn\\.(q_proj|k_proj|v_proj|o_proj)$"
  },
  "training": {
    "learning_rate": 1e-4,
    "per_device_batch_size": 1,
    "grad_accum_steps": 16,
    "epochs": 1,
    "warmup_ratio": 0.05,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,
    "eval_every_steps": 50,
    "save_every_steps": 50,
    "val_loss_n": 100
  }
}
